#!/bin/sh
# LGTV Daemon: NetworkManager runs this before it takes a network interface down, and waits for it.
# When NetworkManager is going to sleep (the PC is suspending), ask each user's LGTV Daemon to turn
# its TVs off now, while the network to the TV still works. Otherwise it does nothing.
[ "$2" = "pre-down" ] || exit 0
nmcli -t -f STATE general 2>/dev/null | grep -qx asleep || exit 0
for s in /run/user/*/lgtv-daemon.sock; do
    [ -S "$s" ] || continue
    timeout 6 python3 -c 'import socket, sys
c = socket.socket(socket.AF_UNIX)
c.settimeout(5)
c.connect(sys.argv[1])
c.sendall(b"prepare_sleep\n")
c.recv(256)' "$s" >/dev/null 2>&1 &
done
wait
exit 0
